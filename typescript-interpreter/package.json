{
  "name": "afm-typescript-interpreter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r exec tsc --noEmit -p tsconfig.json",
    "check": "pnpm run typecheck && pnpm test"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vite": "8.1.6",
    "vitest": "^5.0.3"
  }
}
