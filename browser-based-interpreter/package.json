{
  "name": "@afm/browser-based-interpreter",
  "version": "0.0.0",
  "private": true,
  "description": "Runs AFM agents in the browser.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run typecheck && pnpm test"
  },
  "dependencies": {
    "@afm/adapter-auth": "file:../typescript-interpreter/packages/adapters/auth",
    "@afm/adapter-model": "file:../typescript-interpreter/packages/adapters/model",
    "@afm/adapter-secret": "file:../typescript-interpreter/packages/adapters/secret",
    "@afm/adapter-tool": "file:../typescript-interpreter/packages/adapters/tool",
    "@afm/engine": "file:../typescript-interpreter/packages/engine",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.7.2",
    "vite": "8.1.6",
    "vitest": "^5.0.3"
  }
}
