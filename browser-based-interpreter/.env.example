# Required for any agent that uses an http-transport MCP server: the runtime refuses to connect
# one directly, even to a server with permissive CORS headers. Copy to `.env.local` and point it
# at a running MCP proxy (a separate service, not part of this repository).

# VITE_MCP_PROXY_URL=http://localhost:8787/

# Optional: the public URL of AFM's own OAuth Client ID Metadata Document. A production build writes
# the document to oauth/client-metadata.json, so set it to the address that site is served from.
# Used when a discovered MCP server supports it, so signing in needs no per-server registration;
# without it the app registers itself with each server that supports Dynamic Client Registration,
# which is how local development works.
# VITE_OAUTH_CLIENT_ID_URL=https://afm.example.com/oauth/client-metadata.json
